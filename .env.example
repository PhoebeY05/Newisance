# Database
DATABASE_URL=postgresql://newisance:newisance@localhost:5432/newisance
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=local-dev-secret-change-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
# Google login (optional). Backend token verification.
# The frontend uses the SAME client ID, set as VITE_GOOGLE_CLIENT_ID in
# frontend/.env (read by Vite at build time — local dev and Docker build alike).
# Leave blank to disable Google login (email/password signup still works).
GOOGLE_OAUTH_CLIENT_ID=

# AI — Google AI Studio free tier (https://aistudio.google.com/app/apikey).
# Leave blank to run the AI worker in offline heuristic mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Storage
MEDIA_STORAGE=local
LOCAL_MEDIA_DIR=./media_uploads

# Feature flags
AI_ANALYSIS_ENABLED=true

# Public site address for Caddy (production).
#   unset / :80      -> plain HTTP (e.g. on a bare IP)
#   yourdomain.com   -> Caddy auto-provisions HTTPS via Let's Encrypt
SITE_ADDRESS=

# Public base URL — used in share cards and reward emails.
# Bare IP:  http://<your-server-ip>   |  Domain w/ HTTPS:  https://yourdomain.com
APP_BASE_URL=http://localhost:5173
