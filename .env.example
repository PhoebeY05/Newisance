# Database
DATABASE_URL=postgresql://newisance:newisance@localhost:5432/newisance
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=local-dev-secret-change-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# AI — Google AI Studio free tier (https://aistudio.google.com/app/apikey).
# Leave blank to run the AI worker in offline heuristic mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Storage
MEDIA_STORAGE=local
LOCAL_MEDIA_DIR=./media_uploads

# Service URLs
GAME_SERVICE_URL=http://localhost:8001
COMMUNITY_SERVICE_URL=http://localhost:8003
DASHBOARD_SERVICE_URL=http://localhost:8002

# Feature flags
AI_ANALYSIS_ENABLED=true
