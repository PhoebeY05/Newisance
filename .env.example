# Database
DATABASE_URL=postgresql://newisance:newisance@localhost:5432/newisance
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=local-dev-secret-change-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
# Google login (optional). Use the SAME OAuth client ID for both:
#   GOOGLE_OAUTH_CLIENT_ID  — backend token verification
#   VITE_GOOGLE_CLIENT_ID   — baked into the frontend build (prod: passed as a
#                             build arg by docker-compose.prod.yml)
# Leave blank to disable Google login (email/password signup still works).
GOOGLE_OAUTH_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# AI — Google AI Studio free tier (https://aistudio.google.com/app/apikey).
# Leave blank to run the AI worker in offline heuristic mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Storage
MEDIA_STORAGE=local
LOCAL_MEDIA_DIR=./media_uploads

# Feature flags
AI_ANALYSIS_ENABLED=true

# Public base URL — used in share cards and reward emails.
# In production set this to your server, e.g. http://<your-server-ip>
APP_BASE_URL=http://localhost:5173
